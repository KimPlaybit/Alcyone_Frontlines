include "TriggerLibs/NativeLib"
include "h"

//==================================================================================================
// Proxima Frontlines – Bank / Lobby Load
// Handles reading team assignments and RTS player settings from the bank file and game lobby.
//==================================================================================================

void LoadFromLobby (point lp_startPosition1, point lp_startPosition2) {
    // Automatic Variable Declarations
    // Implementation
    gv_soldierPlayers1 = GameAttributePlayersForTeam(3);
    gv_soldierPlayers2 = GameAttributePlayersForTeam(4);
}

bool LoadedFromBank (point lp_startPosition1, point lp_startPosition2) {
    // Variable Declarations
    bool lv_waves;
    string lv_raceName;
    int lv_index;
    playergroup lv_playerTeam1;
    bool lv_read;
    bank lv_bank;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_waves = GetWaveStatus();
    lv_raceName = "";
    lv_playerTeam1 = PlayerGroupEmpty();
    lv_read = true;

    // Implementation
    BankLoad("gamevalues", 1);
    lv_bank = BankLastCreated();
    if ((BankKeyExists(BankLastCreated(), "gamevalues", "Read") == true)) {
        lv_read = BankValueGetAsFlag(BankLastCreated(), "gamevalues", "Read");
    }
    else {
        return false;
    }
    if ((lv_read == false)) {
        gv_soldierPlayers1 = LoadPlayersFromBank(lv_bank, "SoldierPlayer:1:");
        gv_soldierPlayers2 = LoadPlayersFromBank(lv_bank, "SoldierPlayer:2:");
        gv_rTSPlayer1 = LoadRTSPlayer(lv_bank, "RTSPlayer1");
        gv_rTSPlayer2 = LoadRTSPlayer(lv_bank, "RTSPlayer2");
        SetRTSPlayerRace(lv_bank, "RTSPlayer1Race", gv_rTSPlayer1);
        SetRTSPlayerRace(lv_bank, "RTSPlayer2Race", gv_rTSPlayer2);
        gv_loadedFromBank = true;
        BankValueSetFromFlag(lv_bank, "gamevalues", "Read", true);
        BankSectionRemove(BankLastCreated(), "gamevalues");
        BankSave(lv_bank);
        return true;
    }
    else {
        return false;
    }
}

playergroup LoadPlayersFromBank (bank lp_bank, string lp_key) {
    // Variable Declarations
    int lv_index;
    playergroup lv_players;
    const string lv_section = "gamevalues";

    // Automatic Variable Declarations
    const int auto2151CB17_ae = 5;
    const int auto2151CB17_ai = 1;

    // Variable Initialization
    lv_players = PlayerGroupEmpty();

    // Implementation
    lv_index = 0;
    for ( ; ( (auto2151CB17_ai >= 0 && lv_index <= auto2151CB17_ae) || (auto2151CB17_ai < 0 && lv_index >= auto2151CB17_ae) ) ; lv_index += auto2151CB17_ai ) {
        if ((BankKeyExists(lp_bank, lv_section, (lp_key + IntToString(lv_index))) == true)) {
            PlayerGroupAdd(lv_players, BankValueGetAsInt(lp_bank, lv_section, (lp_key + IntToString(lv_index))));
        }

    }
    return lv_players;
}

int LoadRTSPlayer (bank lp_bank, string lp_key) {
    // Variable Declarations
    playergroup lv_players;
    const string lv_section = "gamevalues";

    // Automatic Variable Declarations
    // Variable Initialization
    lv_players = PlayerGroupEmpty();

    // Implementation
    if ((BankKeyExists(lp_bank, "gamevalues", lp_key) == true)) {
        return BankValueGetAsInt(lp_bank, lv_section, lp_key);
    }

    return 0;
}

void SetRTSPlayerRace (bank lp_bank, string lp_key, int lp_player) {
    // Variable Declarations
    const string lv_section = "gamevalues";
    int lv_race;

    // Automatic Variable Declarations
    int auto4221B408_val;

    // Variable Initialization

    // Implementation
    if ((BankKeyExists(lp_bank, "gamevalues", lp_key) == true)) {
        lv_race = BankValueGetAsInt(lp_bank, "gamevalues", lp_key);
        auto4221B408_val = lv_race;
        if (auto4221B408_val == 1) {
            PlayerSetRace(lp_player, "Terr");
        }
        else if (auto4221B408_val == 2) {
            PlayerSetRace(lp_player, "Zerg");
        }
        else if (auto4221B408_val == 3) {
            PlayerSetRace(lp_player, "Prot");
        }
        else {
        }
    }

}
