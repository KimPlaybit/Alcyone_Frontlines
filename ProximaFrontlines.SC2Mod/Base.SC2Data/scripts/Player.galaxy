void lib5A1C9904_gf_DisplayDeathMessage (unit lp_killed, unit lp_killer, fixed lp_reviveTime) {
    // Variable Declarations
    color lv__AllyColor;
    color lv__EnemyColor;
    text lv__KilledTextBuilder;
    text lv__KillerTextBuilder;

    // Automatic Variable Declarations
    playergroup autoB887724B_g;
    int autoB887724B_var;

    // Variable Initialization
    lv__AllyColor = Color(28*100/255,167*100/255,234*100/255);
    lv__EnemyColor = Color(100.00, 0.00, 0.00);

    // Implementation
    if ((lp_killed != null) && (lp_killer != null)) {
        autoB887724B_g = PlayerGroupActive();
        autoB887724B_var = -1;
        while (true) {
            autoB887724B_var = PlayerGroupNextPlayer(autoB887724B_g, autoB887724B_var);
            if (autoB887724B_var < 0) { break; }
            if ((libNtve_gf_PlayerIsEnemy(autoB887724B_var, UnitGetOwner(lp_killed), libNtve_ge_PlayerRelation_Enemy) == true)) {
                lv__KilledTextBuilder = TextWithColor((PlayerName(UnitGetOwner(lp_killed)) + StringExternal("Param/Value/lib_5A1C9904_BC409EF3") + UnitGetName(lp_killed)), lv__EnemyColor);
            }
            else {
                lv__KilledTextBuilder = TextWithColor((PlayerName(UnitGetOwner(lp_killed)) + StringExternal("Param/Value/lib_5A1C9904_E31F1D0F") + UnitGetName(lp_killed)), lv__AllyColor);
            }
            if ((libNtve_gf_PlayerIsEnemy(autoB887724B_var, UnitGetOwner(lp_killer), libNtve_ge_PlayerRelation_Enemy) == true)) {
                lv__KillerTextBuilder = TextWithColor((PlayerName(UnitGetOwner(lp_killer)) + StringExternal("Param/Value/lib_5A1C9904_E78AA15E") + UnitGetName(lp_killer)), lv__EnemyColor);
            }
            else {
                lv__KillerTextBuilder = TextWithColor((PlayerName(UnitGetOwner(lp_killer)) + StringExternal("Param/Value/lib_5A1C9904_F9D0E981") + UnitGetName(lp_killer)), lv__AllyColor);
            }
            UIDisplayMessage(PlayerGroupSingle(autoB887724B_var), c_messageAreaSubtitle, (lv__KilledTextBuilder + StringExternal("Param/Value/lib_5A1C9904_956C1A6F") + lv__KillerTextBuilder + StringExternal("Param/Value/lib_5A1C9904_5B0D051C") + FixedToText(lp_reviveTime, c_fixedPrecisionAny) + StringExternal("Param/Value/lib_5A1C9904_FA5B4E1A")));
        }
    }

}

