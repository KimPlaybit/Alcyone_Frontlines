//--------------------------------------------------------------------------------------------------
// Trigger: NydusLevel2UpgradeSelection
//--------------------------------------------------------------------------------------------------
bool lib5A1C9904_gt_NydusLevel2UpgradeSelection_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_level;
    fixed lv_unitMoveSpeed;
    string lv_bootsType;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);
    lv_unitMoveSpeed = UnitTypeGetProperty(UnitGetType(EventUnit()), c_unitPropMovementSpeed);

    // Conditions
    if (testConds) {
        if (!((lv_level == 2))) {
            return false;
        }
        if (!((UnitGetType(EventUnit()) == "NydusCanal22" || UnitGetType(EventUnit()) == "MothershipCoreHero" || UnitGetType(EventUnit()) == "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Create upgrade selection dialog
    DialogCreate(350, 270, c_anchorLeft, 20, 0, false);
    lib5A1C9904_gv_nydusLevel2Dialog = DialogLastCreated();

    // Add title label
    libNtve_gf_CreateDialogItemLabel(lib5A1C9904_gv_nydusLevel2Dialog, 260, 30, c_anchorTopLeft, 45, 40, StringExternal("Param/Value/lib_5A1C9904_Level2Title"), ColorWithAlpha(255,255,255,255), false, 1.2);

    // Fortitude Protocol button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_nydusLevel2Dialog, 260, 40, c_anchorTopLeft, 45, 70, StringExternal("Param/Value/lib_5A1C9904_FortitudeTooltip"), StringExternal("Param/Value/lib_5A1C9904_FortitudeProtocol"), "");
    lib5A1C9904_gv_nydusLevel2WorkerProtectionButton = DialogControlLastCreated();

    // Slayer button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_nydusLevel2Dialog, 260, 40, c_anchorTopLeft, 45, 120, StringExternal("Param/Value/lib_5A1C9904_SlayerTooltip"), StringExternal("Param/Value/lib_5A1C9904_Slayer"), "");
    lib5A1C9904_gv_nydusLevel2HeroicVulnerabilityButton = DialogControlLastCreated();

    // Boots button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_nydusLevel2Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_BootsAuraTooltip"), StringExternal("Param/Value/lib_5A1C9904_BootsAura"), "");
    lib5A1C9904_gv_nydusLevel2BootsButton = DialogControlLastCreated();

    // Show dialog only to the player controlling the unit
    DialogSetVisible(lib5A1C9904_gv_nydusLevel2Dialog, PlayerGroupSingle(UnitGetOwner(EventUnit())), true);

    return true;
}

