//--------------------------------------------------------------------------------------------------
bool lib5A1C9904_gt_IncreaseSize_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_scale;
    int lv_indexOfUnit;
    bool lv_unitIsInArray;

    // Automatic Variable Declarations
    int auto36E69086_ae;
    const int auto36E69086_ai = 1;

    // Variable Initialization

