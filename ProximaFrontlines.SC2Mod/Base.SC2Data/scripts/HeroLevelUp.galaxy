//--------------------------------------------------------------------------------------------------
// Trigger: MindControlPrevent
//--------------------------------------------------------------------------------------------------
bool MindControlPrevent_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;
    int lv_caster;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_unit = EventUnit();
    lv_caster = UnitGetOwner(EventUnit());

    // Conditions
    if (testConds) {
        if (!(((UnitGroupHasUnit(gv_revivableUnits, EventUnit()) == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventUnit() != gv_changedUnit)) {
        gv_changedUnit = EventUnit();
        UnitSetOwner(EventUnit(), EventUnitOwnerOld(), true);
    }
    else {
        gv_changedUnit = null;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void MindControlPrevent_Init () {
    MindControlPrevent = TriggerCreate("MindControlPrevent_Func");
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 1)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 2)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 3)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 4)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 5)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 6)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 7)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 8)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 9)));
    TriggerAddEventUnitChangeOwner(MindControlPrevent, UnitRefFromUnit(UnitGroupUnit(gv_revivableUnits, 10)));
}

//--------------------------------------------------------------------------------------------------
// Trigger: NydusLevel2UpgradeSelection
//--------------------------------------------------------------------------------------------------
bool NydusLevel2UpgradeSelection_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_level;
    fixed lv_unitMoveSpeed;
    string lv_bootsType;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);
    lv_unitMoveSpeed = UnitTypeGetProperty(UnitGetType(EventUnit()), c_unitPropMovementSpeed);

    // Conditions
    if (testConds) {
        if (!((lv_level == 2))) {
            return false;
        }
        if (!((UnitGetType(EventUnit()) == "NydusCanal22" || UnitGetType(EventUnit()) == "MothershipCoreHero" || UnitGetType(EventUnit()) == "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Create upgrade selection dialog
    DialogCreate(350, 270, c_anchorLeft, 20, 0, false);
    gv_nydusLevel2Dialog = DialogLastCreated();

    // Add title label
    libNtve_gf_CreateDialogItemLabel(gv_nydusLevel2Dialog, 260, 30, c_anchorTopLeft, 45, 40, StringExternal("Param/Value/lib_5A1C9904_Level2Title"), ColorWithAlpha(255,255,255,255), false, 1.2);

    // Fortitude Protocol button
    libNtve_gf_CreateDialogItemButton(gv_nydusLevel2Dialog, 260, 40, c_anchorTopLeft, 45, 70, StringExternal("Param/Value/lib_5A1C9904_FortitudeTooltip"), StringExternal("Param/Value/lib_5A1C9904_FortitudeProtocol"), "");
    gv_nydusLevel2WorkerProtectionButton = DialogControlLastCreated();

    // Slayer button
    libNtve_gf_CreateDialogItemButton(gv_nydusLevel2Dialog, 260, 40, c_anchorTopLeft, 45, 120, StringExternal("Param/Value/lib_5A1C9904_SlayerTooltip"), StringExternal("Param/Value/lib_5A1C9904_Slayer"), "");
    gv_nydusLevel2HeroicVulnerabilityButton = DialogControlLastCreated();

    // Boots button
    libNtve_gf_CreateDialogItemButton(gv_nydusLevel2Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_BootsAuraTooltip"), StringExternal("Param/Value/lib_5A1C9904_BootsAura"), "");
    gv_nydusLevel2BootsButton = DialogControlLastCreated();

    // Show dialog only to the player controlling the unit
    DialogSetVisible(gv_nydusLevel2Dialog, PlayerGroupSingle(UnitGetOwner(EventUnit())), true);

    return true;
}

//--------------------------------------------------------------------------------------------------
// Trigger: NydusLevel2WorkerProtectionButton
//--------------------------------------------------------------------------------------------------
bool NydusLevel2WorkerProtectionButton_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_selectedUnit;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_selectedUnit = UnitGroupUnit(UnitGroupFilterPlayer(gv_soldiers, EventPlayer(), 0), 1);

    // Conditions
    if (testConds) {
        if (!((gv_nydusLevel2WorkerProtectionButton == EventDialogControl()))) {
            return false;
        }
        if (!((UnitGetType(lv_selectedUnit) == "NydusCanal22" || UnitGetType(lv_selectedUnit) == "MothershipCoreHero" || UnitGetType(lv_selectedUnit) == "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Apply aura behavior for Nydus, regular behavior for MothershipCore/ScienceVessel
    UnitBehaviorAdd(lv_selectedUnit, "NonHeroicDamageReductionAura", lv_selectedUnit, 1);
    DialogSetVisible(gv_nydusLevel2Dialog, PlayerGroupSingle(EventPlayer()), false);

    return true;
}

