    }

    auto36E69086_ae = lib5A1C9904_gv_sizeIndex;
    lv_indexOfUnit = 0;
    for ( ; ( (auto36E69086_ai >= 0 && lv_indexOfUnit <= auto36E69086_ae) || (auto36E69086_ai < 0 && lv_indexOfUnit >= auto36E69086_ae) ) ; lv_indexOfUnit += auto36E69086_ai ) {
        if ((lib5A1C9904_gv_unitSizeIndex[lv_indexOfUnit] == EventUnit())) {
            lv_unitIsInArray = true;
