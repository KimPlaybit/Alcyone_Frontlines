//--------------------------------------------------------------------------------------------------
// Trigger: HeroLevel10UpgradeSelection
//--------------------------------------------------------------------------------------------------
bool lib5A1C9904_gt_HeroLevel10UpgradeSelection_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_level;
    int lv_randomChoice;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);

    // Conditions
    if (testConds) {
        if (!((lv_level == 10))) {
            return false;
        }
        if (!((UnitGetType(EventUnit()) != "NydusCanal22" && UnitGetType(EventUnit()) != "MothershipCoreHero" && UnitGetType(EventUnit()) != "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Auto-pick Level 7 upgrade if not already chosen
    if ((!(UnitBehaviorCount(EventUnit(), "GlassCannonAura") > 0)) && (!(UnitBehaviorCount(EventUnit(), "StructureDefenseAura") > 0)) && (!(UnitBehaviorCount(EventUnit(), "AlliedEnergyAura") > 0))) {
        // Level 7 was not picked, so randomly pick one of the three options
        lv_randomChoice = RandomInt(1, 3);
        
        if ((lv_randomChoice == 1)) {
            // Glass Cannon
            UnitBehaviorAdd(EventUnit(), "GlassCannonAura", EventUnit(), 1);
        }
        else if ((lv_randomChoice == 2)) {
            // Structure Defense
            UnitBehaviorAdd(EventUnit(), "StructureDefenseAura", EventUnit(), 1);
        }
        else {
            // Allied Energy Aura
            UnitBehaviorAdd(EventUnit(), "AlliedEnergyAura", EventUnit(), 1);
        }
    }

    // Hide level 7 dialog if it was shown
    if ((lib5A1C9904_gv_level7Dialog != c_invalidDialogId)) {
        DialogSetVisible(lib5A1C9904_gv_level7Dialog, PlayerGroupAll(), false);
    }

    // Create upgrade selection dialog
    DialogCreate(350, 270, c_anchorLeft, 20, 0, false);
    lib5A1C9904_gv_level10Dialog = DialogLastCreated();

    // Add title label
    libNtve_gf_CreateDialogItemLabel(lib5A1C9904_gv_level10Dialog, 260, 30, c_anchorTopLeft, 45, 40, StringExternal("Param/Value/lib_5A1C9904_Level10Title"), ColorWithAlpha(255,255,255,255), false, 1.2);

    // Base Breaker button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level10Dialog, 260, 40, c_anchorTopLeft, 45, 70, StringExternal("Param/Value/lib_5A1C9904_BaseBreakerTooltip"), StringExternal("Param/Value/lib_5A1C9904_BaseBreaker"), "");
    lib5A1C9904_gv_level10BaseBreakerButton = DialogControlLastCreated();

    // Power Overwhelming button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level10Dialog, 260, 40, c_anchorTopLeft, 45, 120, StringExternal("Param/Value/lib_5A1C9904_PowerOverwhelmingTooltip"), StringExternal("Param/Value/lib_5A1C9904_PowerOverwhelming"), "");
    lib5A1C9904_gv_level10PowerOverwhelmingButton = DialogControlLastCreated();

    // Armor Plates button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level10Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_ArmorPlatesTooltip"), StringExternal("Param/Value/lib_5A1C9904_ArmorPlates"), "");
    lib5A1C9904_gv_level10ArmorPlatesButton = DialogControlLastCreated();

    // Show dialog only to the player controlling the unit
    DialogSetVisible(lib5A1C9904_gv_level10Dialog, PlayerGroupSingle(UnitGetOwner(EventUnit())), true);

    return true;
}

