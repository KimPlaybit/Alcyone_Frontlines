// Trigger: NydusLevel2BootsButton
//--------------------------------------------------------------------------------------------------
bool lib5A1C9904_gt_NydusLevel2BootsButton_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_selectedUnit;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_selectedUnit = UnitGroupUnit(UnitGroupFilterPlayer(lib5A1C9904_gv_soldiers, EventPlayer(), 0), 1);

    // Conditions
    if (testConds) {
        if (!((lib5A1C9904_gv_nydusLevel2BootsButton == EventDialogControl()))) {
            return false;
        }
        if (!((UnitGetType(lv_selectedUnit) == "NydusCanal22" || UnitGetType(lv_selectedUnit) == "MothershipCoreHero" || UnitGetType(lv_selectedUnit) == "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Apply BootsAura for Nydus, MercurialBoots for MothershipCore and ScienceVessel
    if ((UnitGetType(lv_selectedUnit) == "NydusCanal22")) {
        UnitBehaviorAdd(lv_selectedUnit, "BootsAura", lv_selectedUnit, 1);
    } else {
        UnitBehaviorAdd(lv_selectedUnit, "MercurialBoots", lv_selectedUnit, 1);
    }
    DialogSetVisible(lib5A1C9904_gv_nydusLevel2Dialog, PlayerGroupSingle(EventPlayer()), false);

    return true;
}

//--------------------------------------------------------------------------------------------------
// Trigger: HeroLevel2UpgradeSelection
//--------------------------------------------------------------------------------------------------
bool lib5A1C9904_gt_HeroLevel2UpgradeSelection_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_level;
    fixed lv_unitMoveSpeed;
    string lv_bootsType;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);
    lv_unitMoveSpeed = UnitTypeGetProperty(UnitGetType(EventUnit()), c_unitPropMovementSpeed);

    // Conditions
    if (testConds) {
        if (!((lv_level == 2))) {
            return false;
        }
        if (!((UnitGetType(EventUnit()) != "NydusCanal22" && UnitGetType(EventUnit()) != "MothershipCoreHero" && UnitGetType(EventUnit()) != "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Store the unit that leveled up
    lib5A1C9904_gv_level2SelectedUnit = EventUnit();

    // Determine which boots based on movement speed
    if ((lv_unitMoveSpeed > 3.0)) {
        lv_bootsType = "IronBoots";
    }
    else if ((lv_unitMoveSpeed > 2.9)) {
        lv_bootsType = "MercurialBoots";
    }
    else {
        lv_bootsType = "VelocityBoots";
    }

    // Create upgrade selection dialog
    DialogCreate(350, 270, c_anchorLeft, 20, 0, false);
    lib5A1C9904_gv_level2Dialog = DialogLastCreated();

    // Add title label
    libNtve_gf_CreateDialogItemLabel(lib5A1C9904_gv_level2Dialog, 260, 30, c_anchorTopLeft, 45, 40, StringExternal("Param/Value/lib_5A1C9904_Level2Title"), ColorWithAlpha(255,255,255,255), false, 1.2);

    // Fortitude Protocol button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level2Dialog, 260, 40, c_anchorTopLeft, 45, 70, StringExternal("Param/Value/lib_5A1C9904_FortitudeTooltip"), StringExternal("Param/Value/lib_5A1C9904_FortitudeProtocol"), "");
    lib5A1C9904_gv_level2WorkerProtectionButton = DialogControlLastCreated();

    // Slayer button
    libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level2Dialog, 260, 40, c_anchorTopLeft, 45, 120, StringExternal("Param/Value/lib_5A1C9904_SlayerTooltip"), StringExternal("Param/Value/lib_5A1C9904_Slayer"), "");
    lib5A1C9904_gv_level2HeroicVulnerabilityButton = DialogControlLastCreated();

    // Boots button (dynamic name based on speed)
    if ((lv_unitMoveSpeed > 3.0)) {
        libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level2Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_IronTooltip"), StringExternal("Param/Value/lib_5A1C9904_IronBoots"), "");
    }
    else if ((lv_unitMoveSpeed > 2.9)) {
        libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level2Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_MercurialTooltip"), StringExternal("Param/Value/lib_5A1C9904_MercurialBoots"), "");
    }
    else {
        libNtve_gf_CreateDialogItemButton(lib5A1C9904_gv_level2Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_VelocityTooltip"), StringExternal("Param/Value/lib_5A1C9904_VelocityBoots"), "");
    }
    lib5A1C9904_gv_level2BootsButton = DialogControlLastCreated();

    // Show dialog only to the player controlling the unit
    DialogSetVisible(lib5A1C9904_gv_level2Dialog, PlayerGroupSingle(UnitGetOwner(EventUnit())), true);

    return true;
}

