    MedicLevelUp = TriggerCreate("MedicLevelUp_Func");
    TriggerAddEventUnitGainLevel(MedicLevelUp, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: ScienceVesselLevelUp
//--------------------------------------------------------------------------------------------------
bool ScienceVesselLevelUp_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_level;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (((lv_level >= 1) && (lv_level <= 4))) {
        TechTreeUpgradeAddLevel(UnitGetOwner(EventUnit()), "ScienceVessel1to4", 1);
    }

    if (((lv_level >= 5) && (lv_level <= 7))) {
        TechTreeUpgradeAddLevel(UnitGetOwner(EventUnit()), "ScienceVessel1to4", 1);
    }

    if (((lv_level >= 8) && (lv_level <= 10))) {
        TechTreeUpgradeAddLevel(UnitGetOwner(EventUnit()), "ScienceVessel8to10", 1);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ScienceVesselLevelUp_Init () {
    ScienceVesselLevelUp = TriggerCreate("ScienceVesselLevelUp_Func");
    TriggerAddEventUnitGainLevel(ScienceVesselLevelUp, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: FirebatAvatar
//--------------------------------------------------------------------------------------------------
bool FirebatAvatar_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_caster;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_caster = EventUnit();

    // Actions
    if (!runActions) {
        return true;
    }

    UnitSetScale(lv_caster, 110.0, 110.0, 110.0);
    Wait(15.0, c_timeGame);
    UnitSetScale(lv_caster, 100.0, 100.0, 100.0);
    return true;
}

//--------------------------------------------------------------------------------------------------
void FirebatAvatar_Init () {
    FirebatAvatar = TriggerCreate("FirebatAvatar_Func");
    TriggerAddEventUnitAbility(FirebatAvatar, null, AbilityCommand("FirebatAvatar", 0), c_unitAbilStageExecute, false);
}

