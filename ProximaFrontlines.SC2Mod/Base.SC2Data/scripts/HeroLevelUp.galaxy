//--------------------------------------------------------------------------------------------------
// Trigger: IncreaseSize
//--------------------------------------------------------------------------------------------------
bool IncreaseSize_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_scale;
    int lv_indexOfUnit;
    bool lv_unitIsInArray;

    // Automatic Variable Declarations
    int auto36E69086_ae;
    const int auto36E69086_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "HotSTorrasque2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto36E69086_ae = gv_sizeIndex;
    lv_indexOfUnit = 0;
    for ( ; ( (auto36E69086_ai >= 0 && lv_indexOfUnit <= auto36E69086_ae) || (auto36E69086_ai < 0 && lv_indexOfUnit >= auto36E69086_ae) ) ; lv_indexOfUnit += auto36E69086_ai ) {
        if ((gv_unitSizeIndex[lv_indexOfUnit] == EventUnit())) {
            lv_unitIsInArray = true;
            break;
        }

    }
    if ((lv_unitIsInArray == true)) {
        lv_scale = (gv_unitSizes[lv_indexOfUnit] + 7);
        gv_unitSizes[lv_indexOfUnit] = (lv_scale + 7);
    }
    else {
        lv_scale = 52;
        gv_unitSizeIndex[gv_sizeIndex] = EventUnit();
        gv_unitSizes[gv_sizeIndex] = lv_scale;
        gv_sizeIndex = (gv_sizeIndex + 1);
    }
    UnitSetScale(EventUnit(), lv_scale, lv_scale, lv_scale);
    return true;
}

//--------------------------------------------------------------------------------------------------
void IncreaseSize_Init () {
    IncreaseSize = TriggerCreate("IncreaseSize_Func");
    TriggerAddEventUnitGainLevel(IncreaseSize, null);
}

