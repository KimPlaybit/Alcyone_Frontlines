    // Create upgrade selection dialog
    DialogCreate(350, 270, c_anchorLeft, 20, 0, false);
    lib5A1C9904_gv_nydusLevel10Dialog = DialogLastCreated();

    // Add title label
    libNtve_gf_CreateDialogItemLabel(lib5A1C9904_gv_nydusLevel10Dialog, 260, 30, c_anchorTopLeft, 45, 40, StringExternal("Param/Value/lib_5A1C9904_Level10Title"), ColorWithAlpha(255,255,255,255), false, 1.2);

