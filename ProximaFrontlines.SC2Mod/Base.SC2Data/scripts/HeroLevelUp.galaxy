bool lib5A1C9904_gt_FirebatAvatar_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_caster;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_caster = EventUnit();

    // Actions
    if (!runActions) {
        return true;
    }

    UnitSetScale(lv_caster, 110.0, 110.0, 110.0);
    Wait(15.0, c_timeGame);
    UnitSetScale(lv_caster, 100.0, 100.0, 100.0);
    return true;
}

