    int lv_level;
    fixed lv_unitMoveSpeed;
    string lv_bootsType;
    int lv_randomChoice;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);
    lv_unitMoveSpeed = UnitTypeGetProperty(UnitGetType(EventUnit()), c_unitPropMovementSpeed);

    // Conditions
    if (testConds) {
        if (!((lv_level == 5))) {
            return false;
        }
        if (!((UnitGetType(EventUnit()) != "NydusCanal22" && UnitGetType(EventUnit()) != "MothershipCoreHero" && UnitGetType(EventUnit()) != "ScienceVessel2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Auto-pick Level 2 upgrade if not already chosen
    if ((!(UnitBehaviorCount(EventUnit(), "NonHeroicDamageReduction") > 0)) && (!(UnitBehaviorCount(EventUnit(), "HeroicDamageBonus") > 0)) && (!(UnitBehaviorCount(EventUnit(), "IronBoots") > 0)) && (!(UnitBehaviorCount(EventUnit(), "MercurialBoots") > 0)) && (!(UnitBehaviorCount(EventUnit(), "VelocityBoots") > 0))) {
        // Level 2 was not picked, so randomly pick one of the three options
        lv_randomChoice = RandomInt(1, 3);
        
        if ((lv_randomChoice == 1)) {
            // Worker Protection
            UnitBehaviorAdd(gv_level5SelectedUnit, "NonHeroicDamageReduction", gv_level5SelectedUnit, 1);
        }
        else if ((lv_randomChoice == 2)) {
            // Slayer
            UnitBehaviorAdd(gv_level5SelectedUnit, "HeroicDamageBonus", gv_level5SelectedUnit, 1);
        }
        else {
            // Boots (determined by movement speed)
            if ((lv_unitMoveSpeed > 3.0)) {
                lv_bootsType = "IronBoots";
            }
            else if ((lv_unitMoveSpeed > 2.9)) {
                lv_bootsType = "MercurialBoots";
            }
            else {
                lv_bootsType = "VelocityBoots";
            }
            UnitBehaviorAdd(gv_level5SelectedUnit, lv_bootsType, gv_level5SelectedUnit, 1);
        }
    }

    // Hide level 2 dialog if it was shown
    if ((gv_level2Dialog != c_invalidDialogId)) {
        DialogSetVisible(gv_level2Dialog, PlayerGroupAll(), false);
    }

    // Create upgrade selection dialog
    DialogCreate(350, 270, c_anchorLeft, 20, 0, false);
    gv_level5Dialog = DialogLastCreated();

    // Add title label
    libNtve_gf_CreateDialogItemLabel(gv_level5Dialog, 260, 30, c_anchorTopLeft, 45, 40, StringExternal("Param/Value/lib_5A1C9904_Level5Title"), ColorWithAlpha(255,255,255,255), false, 1.2);

    // Energy Regen button
    libNtve_gf_CreateDialogItemButton(gv_level5Dialog, 260, 40, c_anchorTopLeft, 45, 70, StringExternal("Param/Value/lib_5A1C9904_EnergyRegenTooltip"), StringExternal("Param/Value/lib_5A1C9904_EnergyRegen"), "");
    gv_level5EnergyRegenButton = DialogControlLastCreated();

    // Healing Boost button
    libNtve_gf_CreateDialogItemButton(gv_level5Dialog, 260, 40, c_anchorTopLeft, 45, 120, StringExternal("Param/Value/lib_5A1C9904_HealingBoostTooltip"), StringExternal("Param/Value/lib_5A1C9904_HealingBoost"), "");
    gv_level5HealingBoostButton = DialogControlLastCreated();

    // Anti-Air Damage button
    libNtve_gf_CreateDialogItemButton(gv_level5Dialog, 260, 40, c_anchorTopLeft, 45, 170, StringExternal("Param/Value/lib_5A1C9904_AntiAirTooltip"), StringExternal("Param/Value/lib_5A1C9904_AntiAir"), "");
    gv_level5DamageBoostButton = DialogControlLastCreated();

    // Show dialog only to the player controlling the unit
    DialogSetVisible(gv_level5Dialog, PlayerGroupSingle(UnitGetOwner(EventUnit())), true);

    return true;
}

