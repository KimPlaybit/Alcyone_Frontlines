include "TriggerLibs/NativeLib"

//==================================================================================================
// Proxima Frontlines - Hero Level-Up System
// Per-hero level-up event triggers plus upgrade selection dialog triggers.
//==================================================================================================
bool DarkTemplarLevelUp_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_level;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(EventUnit(), null);

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "AvengerHero"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (((lv_level >= 1) && (lv_level <= 4))) {
        TechTreeUpgradeAddLevel(UnitGetOwner(EventUnit()), "DarkTemplar1to4", 1);
    }

    if (((lv_level >= 5) && (lv_level <= 7))) {
        TechTreeUpgradeAddLevel(UnitGetOwner(EventUnit()), "DarkTemplar5to7", 1);
    }

    if (((lv_level >= 8) && (lv_level <= 10))) {
        TechTreeUpgradeAddLevel(UnitGetOwner(EventUnit()), "DarkTemplar8to10", 1);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void DarkTemplarLevelUp_Init () {
    DarkTemplarLevelUp = TriggerCreate("DarkTemplarLevelUp_Func");
    TriggerAddEventUnitGainLevel(DarkTemplarLevelUp, null);
}

