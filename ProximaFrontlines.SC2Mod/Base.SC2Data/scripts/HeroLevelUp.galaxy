    lib5A1C9904_gv_nydusLevel10ArmorPlatesButton = DialogControlLastCreated();

    // Show dialog only to the player controlling the unit
    DialogSetVisible(lib5A1C9904_gv_level10Dialog, PlayerGroupSingle(UnitGetOwner(EventUnit())), true);

    return true;
