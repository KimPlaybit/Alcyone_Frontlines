    lib5A1C9904_gt_NydusLevel2UpgradeSelection = TriggerCreate("lib5A1C9904_gt_NydusLevel2UpgradeSelection_Func");
    TriggerAddEventUnitGainLevel(lib5A1C9904_gt_NydusLevel2UpgradeSelection, null);
