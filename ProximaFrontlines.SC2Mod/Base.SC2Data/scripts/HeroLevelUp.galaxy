    if ((lv_unitIsInArray == true)) {
        lv_scale = (lib5A1C9904_gv_unitSizes[lv_indexOfUnit] + 7);
        lib5A1C9904_gv_unitSizes[lv_indexOfUnit] = (lv_scale + 7);
    }
    else {
        lv_scale = 52;
        lib5A1C9904_gv_unitSizeIndex[lib5A1C9904_gv_sizeIndex] = EventUnit();
        lib5A1C9904_gv_unitSizes[lib5A1C9904_gv_sizeIndex] = lv_scale;
