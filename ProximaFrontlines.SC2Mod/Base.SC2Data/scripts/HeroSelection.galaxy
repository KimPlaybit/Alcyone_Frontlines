include "Lib5A1C9904_h"

//==================================================================================================
// Proxima Frontlines – Hero Selection System
// Dialog button triggers for hero picking and lock-in for both teams.
//==================================================================================================

bool lib5A1C9904_gt_FirebatSoldierPicked_Func (bool testConds, bool runActions) {
    // Variable Declarations
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((lib5A1C9904_gv_playerPicked[EventPlayer()] == false) && ((lib5A1C9904_gv_firebatTeam1 == EventDialogControl()) || (lib5A1C9904_gv_firebatTeam2 == EventDialogControl()))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Save selected hero for this player
    if ((PlayerGetAlliance(lib5A1C9904_gv_rTSPlayer1, c_allianceIdVision, EventPlayer()) == true)) {
        lib5A1C9904_gv_selectedHeroTeam1 = "FirebatHero";
        lib5A1C9904_gf_UpdateHeroInfoTeam1(lib5A1C9904_gv_selectedHeroTeam1);
    }
    else {
        lib5A1C9904_gv_selectedHeroTeam2 = "FirebatHero";
        lib5A1C9904_gf_UpdateHeroInfoTeam2(lib5A1C9904_gv_selectedHeroTeam2);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib5A1C9904_gt_FirebatSoldierPicked_Init () {
    lib5A1C9904_gt_FirebatSoldierPicked = TriggerCreate("lib5A1C9904_gt_FirebatSoldierPicked_Func");
    TriggerAddEventDialogControl(lib5A1C9904_gt_FirebatSoldierPicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

