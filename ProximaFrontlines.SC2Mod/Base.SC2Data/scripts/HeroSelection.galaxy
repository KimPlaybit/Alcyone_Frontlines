//--------------------------------------------------------------------------------------------------
// Trigger: Lock In Button Team 1
//--------------------------------------------------------------------------------------------------
bool LockInButtonTeam1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_heroDisplayName;
    
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_lockInButtonTeam1 == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((StringLength(gv_selectedHeroTeam1) > 0)) {
        lv_heroDisplayName = gv_selectedHeroTeam1;
        if ((gv_selectedHeroTeam1 == "FirebatHero")) { lv_heroDisplayName = "Firebat"; }
        else if ((gv_selectedHeroTeam1 == "MedicHero")) { lv_heroDisplayName = "Medic"; }
        else if ((gv_selectedHeroTeam1 == "MarineHero")) { lv_heroDisplayName = "Marine"; }
        else if ((gv_selectedHeroTeam1 == "GoliathHero")) { lv_heroDisplayName = "Goliath"; }
        else if ((gv_selectedHeroTeam1 == "SpectreHero")) { lv_heroDisplayName = "Spectre"; }
        else if ((gv_selectedHeroTeam1 == "ZealotHero")) { lv_heroDisplayName = "Zealot"; }
        else if ((gv_selectedHeroTeam1 == "AvengerHero")) { lv_heroDisplayName = "Dark Templar"; }
        else if ((gv_selectedHeroTeam1 == "DragoonHero")) { lv_heroDisplayName = "Dragoon"; }
        else if ((gv_selectedHeroTeam1 == "SentryPurifier2")) { lv_heroDisplayName = "Sentry"; }
        else if ((gv_selectedHeroTeam1 == "AdeptHero")) { lv_heroDisplayName = "Adept"; }
        else if ((gv_selectedHeroTeam1 == "CorsairHero")) { lv_heroDisplayName = "Corsair"; }
        else if ((gv_selectedHeroTeam1 == "MothershipCoreHero")) { lv_heroDisplayName = "Mothership Core"; }
        else if ((gv_selectedHeroTeam1 == "ZerglingHero")) { lv_heroDisplayName = "Zergling"; }
        else if ((gv_selectedHeroTeam1 == "BroodQueenHero")) { lv_heroDisplayName = "Brood Queen"; }
        else if ((gv_selectedHeroTeam1 == "DefilerHero")) { lv_heroDisplayName = "Defiler"; }
        else if ((gv_selectedHeroTeam1 == "HydraliskHero")) { lv_heroDisplayName = "Hydralisk"; }
        else if ((gv_selectedHeroTeam1 == "HotSTorrasque2")) { lv_heroDisplayName = "Ultralisk"; }
        else if ((gv_selectedHeroTeam1 == "MutaliskHero")) { lv_heroDisplayName = "Mutalisk"; }
        else if ((gv_selectedHeroTeam1 == "NydusCanal22")) { lv_heroDisplayName = "Nydus Worm"; }
        else if ((gv_selectedHeroTeam1 == "ScienceVessel2")) { lv_heroDisplayName = "Science Vessel"; }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (PlayerName(EventPlayer()) + StringToText(" picked " + lv_heroDisplayName)));
        libNtve_gf_UnitCreateFacingPoint(1, gv_selectedHeroTeam1, 0, EventPlayer(), gv_startPosition1, PlayerStartLocation(gv_rTSPlayer2));
        DialogSetVisible(gv_dialogTeam1, PlayerGroupAll(), false);
        UnitSelect(UnitLastCreated(), EventPlayer(), true);
        UnitGroupAdd(gv_revivableUnits, UnitLastCreated());
        UnitGroupAdd(gv_soldiers, UnitLastCreated());
        UnitControlGroupAddUnit(EventPlayer(), 1, UnitLastCreated());
        PlayerGroupAdd(gv_playersWhoPicked, EventPlayer());
        gv_playerPicked[EventPlayer()] = true;
    }
    return true;
}

void LockInButtonTeam1_Init () {
    LockInButtonTeam1Pressed = TriggerCreate("LockInButtonTeam1_Func");
    TriggerAddEventDialogControl(LockInButtonTeam1Pressed, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Lock In Button Team 2
//--------------------------------------------------------------------------------------------------
bool LockInButtonTeam2_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_heroDisplayName;
    
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_lockInButtonTeam2 == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((StringLength(gv_selectedHeroTeam2) > 0)) {
        lv_heroDisplayName = gv_selectedHeroTeam2;
        if ((gv_selectedHeroTeam2 == "FirebatHero")) { lv_heroDisplayName = "Firebat"; }
        else if ((gv_selectedHeroTeam2 == "MedicHero")) { lv_heroDisplayName = "Medic"; }
        else if ((gv_selectedHeroTeam2 == "MarineHero")) { lv_heroDisplayName = "Marine"; }
        else if ((gv_selectedHeroTeam2 == "GoliathHero")) { lv_heroDisplayName = "Goliath"; }
        else if ((gv_selectedHeroTeam2 == "SpectreHero")) { lv_heroDisplayName = "Spectre"; }
        else if ((gv_selectedHeroTeam2 == "ZealotHero")) { lv_heroDisplayName = "Zealot"; }
        else if ((gv_selectedHeroTeam2 == "AvengerHero")) { lv_heroDisplayName = "Dark Templar"; }
        else if ((gv_selectedHeroTeam2 == "DragoonHero")) { lv_heroDisplayName = "Dragoon"; }
        else if ((gv_selectedHeroTeam2 == "SentryPurifier2")) { lv_heroDisplayName = "Sentry"; }
        else if ((gv_selectedHeroTeam2 == "AdeptHero")) { lv_heroDisplayName = "Adept"; }
        else if ((gv_selectedHeroTeam2 == "CorsairHero")) { lv_heroDisplayName = "Corsair"; }
        else if ((gv_selectedHeroTeam2 == "MothershipCoreHero")) { lv_heroDisplayName = "Mothership Core"; }
        else if ((gv_selectedHeroTeam2 == "ZerglingHero")) { lv_heroDisplayName = "Zergling"; }
        else if ((gv_selectedHeroTeam2 == "BroodQueenHero")) { lv_heroDisplayName = "Brood Queen"; }
        else if ((gv_selectedHeroTeam2 == "DefilerHero")) { lv_heroDisplayName = "Defiler"; }
        else if ((gv_selectedHeroTeam2 == "HydraliskHero")) { lv_heroDisplayName = "Hydralisk"; }
        else if ((gv_selectedHeroTeam2 == "HotSTorrasque2")) { lv_heroDisplayName = "Ultralisk"; }
        else if ((gv_selectedHeroTeam2 == "MutaliskHero")) { lv_heroDisplayName = "Mutalisk"; }
        else if ((gv_selectedHeroTeam2 == "NydusCanal22")) { lv_heroDisplayName = "Nydus Worm"; }
        else if ((gv_selectedHeroTeam2 == "ScienceVessel2")) { lv_heroDisplayName = "Science Vessel"; }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (PlayerName(EventPlayer()) + StringToText(" picked " + lv_heroDisplayName)));

        libNtve_gf_UnitCreateFacingPoint(1, gv_selectedHeroTeam2, 0, EventPlayer(), gv_startPosition2, PlayerStartLocation(gv_rTSPlayer1));
        DialogSetVisible(gv_dialogTeam2, PlayerGroupAll(), false);
        UnitSelect(UnitLastCreated(), EventPlayer(), true);
        UnitGroupAdd(gv_revivableUnits, UnitLastCreated());
        UnitGroupAdd(gv_soldiers, UnitLastCreated());
        UnitControlGroupAddUnit(EventPlayer(), 1, UnitLastCreated());
        PlayerGroupAdd(gv_playersWhoPicked, EventPlayer());
        gv_playerPicked[EventPlayer()] = true;
    }
    return true;
}

