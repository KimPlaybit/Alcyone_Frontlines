include "TriggerLibs/NativeLib"
include "h"

//==================================================================================================
// Proxima Frontlines – Hero Selection System
// Dialog button triggers for hero picking and lock-in for both teams.
//==================================================================================================

bool FirebatSoldierPicked_Func (bool testConds, bool runActions) {
    // Variable Declarations
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((gv_playerPicked[EventPlayer()] == false) && ((gv_firebatTeam1 == EventDialogControl()) || (gv_firebatTeam2 == EventDialogControl()))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // Save selected hero for this player
    if ((PlayerGetAlliance(gv_rTSPlayer1, c_allianceIdVision, EventPlayer()) == true)) {
        gv_selectedHeroTeam1 = "FirebatHero";
        UpdateHeroInfoTeam1(gv_selectedHeroTeam1);
    }
    else {
        gv_selectedHeroTeam2 = "FirebatHero";
        UpdateHeroInfoTeam2(gv_selectedHeroTeam2);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void FirebatSoldierPicked_Init () {
    FirebatSoldierPicked = TriggerCreate("FirebatSoldierPicked_Func");
    TriggerAddEventDialogControl(FirebatSoldierPicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

