bool lib5A1C9904_gt_LockInButtonTeam1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_heroDisplayName;
    
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((lib5A1C9904_gv_lockInButtonTeam1 == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((StringLength(lib5A1C9904_gv_selectedHeroTeam1) > 0)) {
        lv_heroDisplayName = lib5A1C9904_gv_selectedHeroTeam1;
        if ((lib5A1C9904_gv_selectedHeroTeam1 == "FirebatHero")) { lv_heroDisplayName = "Firebat"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "MedicHero")) { lv_heroDisplayName = "Medic"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "MarineHero")) { lv_heroDisplayName = "Marine"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "GoliathHero")) { lv_heroDisplayName = "Goliath"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "SpectreHero")) { lv_heroDisplayName = "Spectre"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "ZealotHero")) { lv_heroDisplayName = "Zealot"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "AvengerHero")) { lv_heroDisplayName = "Dark Templar"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "DragoonHero")) { lv_heroDisplayName = "Dragoon"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "SentryPurifier2")) { lv_heroDisplayName = "Sentry"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "AdeptHero")) { lv_heroDisplayName = "Adept"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "CorsairHero")) { lv_heroDisplayName = "Corsair"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "MothershipCoreHero")) { lv_heroDisplayName = "Mothership Core"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "ZerglingHero")) { lv_heroDisplayName = "Zergling"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "BroodQueenHero")) { lv_heroDisplayName = "Brood Queen"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "DefilerHero")) { lv_heroDisplayName = "Defiler"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "HydraliskHero")) { lv_heroDisplayName = "Hydralisk"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "HotSTorrasque2")) { lv_heroDisplayName = "Ultralisk"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "MutaliskHero")) { lv_heroDisplayName = "Mutalisk"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "NydusCanal22")) { lv_heroDisplayName = "Nydus Worm"; }
        else if ((lib5A1C9904_gv_selectedHeroTeam1 == "ScienceVessel2")) { lv_heroDisplayName = "Science Vessel"; }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (PlayerName(EventPlayer()) + StringToText(" picked " + lv_heroDisplayName)));
        libNtve_gf_UnitCreateFacingPoint(1, lib5A1C9904_gv_selectedHeroTeam1, 0, EventPlayer(), lib5A1C9904_gv_startPosition1, PlayerStartLocation(lib5A1C9904_gv_rTSPlayer2));
        DialogSetVisible(lib5A1C9904_gv_dialogTeam1, PlayerGroupAll(), false);
        UnitSelect(UnitLastCreated(), EventPlayer(), true);
        UnitGroupAdd(lib5A1C9904_gv_revivableUnits, UnitLastCreated());
        UnitGroupAdd(lib5A1C9904_gv_soldiers, UnitLastCreated());
        UnitControlGroupAddUnit(EventPlayer(), 1, UnitLastCreated());
        PlayerGroupAdd(lib5A1C9904_gv_playersWhoPicked, EventPlayer());
        lib5A1C9904_gv_playerPicked[EventPlayer()] = true;
    }
    return true;
}

