//--------------------------------------------------------------------------------------------------
bool AdeptPicked_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!(((gv_playerPicked[EventPlayer()] == false) && (((PlayerRace(gv_rTSPlayer1) == "Prot") && (GetAllyRTSPlayer(EventPlayer()) == gv_rTSPlayer1)) || ((PlayerRace(gv_rTSPlayer2) == "Prot") && (GetAllyRTSPlayer(EventPlayer()) == gv_rTSPlayer2)))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((GetAllyRTSPlayer(EventPlayer()) == gv_rTSPlayer1)) {
        gv_selectedHeroTeam1 = "AdeptHero";
        UpdateHeroInfoTeam1(gv_selectedHeroTeam1);
    }
    else {
        gv_selectedHeroTeam2 = "AdeptHero";
        UpdateHeroInfoTeam2(gv_selectedHeroTeam2);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void AdeptPicked_Init () {
    AdeptPicked = TriggerCreate("AdeptPicked_Func");
    TriggerAddEventChatMessage(AdeptPicked, c_playerAny, "-Adept", true);
}

