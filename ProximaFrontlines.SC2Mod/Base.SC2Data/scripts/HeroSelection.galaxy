    if (testConds) {
        if (!(((lib5A1C9904_gv_playerPicked[EventPlayer()] == false) && (((PlayerRace(lib5A1C9904_gv_rTSPlayer1) == "Prot") && (lib5A1C9904_gf_GetAllyRTSPlayer(EventPlayer()) == lib5A1C9904_gv_rTSPlayer1)) || ((PlayerRace(lib5A1C9904_gv_rTSPlayer2) == "Prot") && (lib5A1C9904_gf_GetAllyRTSPlayer(EventPlayer()) == lib5A1C9904_gv_rTSPlayer2)))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((lib5A1C9904_gf_GetAllyRTSPlayer(EventPlayer()) == lib5A1C9904_gv_rTSPlayer1)) {
        lib5A1C9904_gv_selectedHeroTeam1 = "AdeptHero";
        lib5A1C9904_gf_UpdateHeroInfoTeam1(lib5A1C9904_gv_selectedHeroTeam1);
    }
    else {
        lib5A1C9904_gv_selectedHeroTeam2 = "AdeptHero";
        lib5A1C9904_gf_UpdateHeroInfoTeam2(lib5A1C9904_gv_selectedHeroTeam2);
