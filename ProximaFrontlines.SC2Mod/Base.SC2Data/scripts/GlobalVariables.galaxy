//==================================================================================================
// Proxima Frontlines – Global Variables
// Struct definitions, global declarations, trigger variables, function forward declarations,
// and variable initialization. Follows SSF-style: all declarations at top, InitVariables() last.
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// Structs
//--------------------------------------------------------------------------------------------------
struct lib5A1C9904_gs_UnitSpawn {
    string lv_unitType;
    int    lv_amount;
};

struct lib5A1C9904_gs_Spawn {
    point   lv_point;
    int     lv_respawnTime;
    int     lv_spawnTime;
    trigger lv_deathCallbackTrigger;
    lib5A1C9904_gs_UnitSpawn[5] lv_unitSpawn;
};

struct lib5A1C9904_gs_SpawnerInfo {
    string lv_unitType;
    point  lv_point;
    int    lv_player;
};

struct lib5A1C9904_gs_CreatedSpawner {
    unit      lv_spawner;
    int       lv_lastIndexPoint;
    point[11] lv_movePoints;
    int       lv_amountOfUnits;
    string    lv_waveUnitType;
};

struct lib5A1C9904_gs_JunglePrice {
    string lv_unitType;
    int    lv_minerals;
    int    lv_gas;
};

