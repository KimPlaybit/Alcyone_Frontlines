//--------------------------------------------------------------------------------------------------
// Trigger: Lock In Button Team 1
//--------------------------------------------------------------------------------------------------
bool LockInButtonTeam1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_heroDisplayName;
    
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_lockInButtonTeam1 == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((StringLength(gv_selectedHeroTeam1[EventPlayer()]) > 0)) {
        lv_heroDisplayName = gv_selectedHeroTeam1[EventPlayer()];
        if ((gv_selectedHeroTeam1[EventPlayer()] == "FirebatHero")) { lv_heroDisplayName = "Firebat"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "MedicHero")) { lv_heroDisplayName = "Medic"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "MarineHero")) { lv_heroDisplayName = "Marine"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "GoliathHero")) { lv_heroDisplayName = "Goliath"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "SpectreHero")) { lv_heroDisplayName = "Spectre"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "ZealotHero")) { lv_heroDisplayName = "Zealot"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "AvengerHero")) { lv_heroDisplayName = "Dark Templar"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "DragoonHero")) { lv_heroDisplayName = "Dragoon"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "SentryPurifier2")) { lv_heroDisplayName = "Sentry"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "AdeptHero")) { lv_heroDisplayName = "Adept"; }
