//--------------------------------------------------------------------------------------------------
// Soldier Selection Team 1
//--------------------------------------------------------------------------------------------------
trigger auto_SoldierSelectionTeam1_Trigger = null;

void SoldierSelectionTeam1 () {
    if (auto_SoldierSelectionTeam1_Trigger == null) {
        auto_SoldierSelectionTeam1_Trigger = TriggerCreate("auto_SoldierSelectionTeam1_TriggerFunc");
    }
    TriggerExecute(auto_SoldierSelectionTeam1_Trigger, false, false);
}

bool auto_SoldierSelectionTeam1_TriggerFunc (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_raceCheck;
    int lv_dialogWidth        = 1200;
    int lv_dialogHeight       = 600;
    int lv_leftPanelWidth     = 350;
    int lv_leftPanelXPos      = -600;
    int lv_middlePanelWidth   = 310;
    int lv_middlePanelXPos    = 450;
    int lv_rightPanelWidth    = 420;
    int lv_rightPanelXPos     = 30;
    int lv_buttonSizePickX    = 340;
    int lv_buttonSizePickY    = 50;
    int lv_buttonXPos         = -380;
    int lv_lockInButtonWidth  = 260;
    int lv_lockInButtonHeight = 50;
    int lv_lockInButtonXPos   = 470;
    int lv_lockInButtonYPos   = 500;
    int lv_infoLabelWidth     = 350;
    int lv_infoLabelXPos      = 400;
    int lv_pIdx;

    // Implementation
    DialogCreate(lv_dialogWidth, lv_dialogHeight, c_anchorCenter, 0, -60, true);
    gv_dialogTeam1 = DialogLastCreated();

    // Create LEFT PANEL for hero selection
    DialogControlCreate(gv_dialogTeam1, c_triggerControlTypePanel);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), lv_leftPanelWidth, lv_dialogHeight);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTopLeft, lv_leftPanelXPos, 0);

    // Create MIDDLE PANEL for portrait display
    DialogControlCreate(gv_dialogTeam1, c_triggerControlTypePanel);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), lv_middlePanelWidth, lv_dialogHeight);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTopLeft, lv_middlePanelXPos, 0);
    // Add hero portrait image to middle panel
    DialogControlCreate(gv_dialogTeam1, c_triggerControlTypeImage);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), lv_middlePanelWidth - 20, 400);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTopLeft, lv_middlePanelXPos + 10, 70);
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\firebatportrait_static.dds", PlayerGroupAll());
    gv_heroPortraitTeam1 = DialogControlLastCreated();

    // Create RIGHT PANEL for abilities
    DialogControlCreate(gv_dialogTeam1, c_triggerControlTypePanel);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), lv_rightPanelWidth, lv_dialogHeight);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTopLeft, lv_rightPanelXPos, 0);
    gv_infoPanelTeam1 = DialogControlLastCreated();

    // Hero selection header
    libNtve_gf_CreateDialogItemLabel(gv_dialogTeam1, lv_leftPanelWidth - 20, 50, c_anchorTopLeft, lv_leftPanelXPos + 10, 10, StringExternal("Param/Value/lib_5A1C9904_E81AAFB7"), ColorWithAlpha(200,180,100,255), false, 2.0);

    lv_raceCheck = IsTerran(gv_rTSPlayer1);
    if ((lv_raceCheck == true)) {
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 100, StringExternal("Param/Value/lib_5A1C9904_CDC87703"), StringExternal("Param/Value/lib_5A1C9904_E1FADDDA"), "");
        gv_firebatTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 160, StringExternal("Param/Value/lib_5A1C9904_2C347B6C"), StringExternal("Param/Value/lib_5A1C9904_63AEB7D7"), "");
        gv_medicTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 220, StringExternal("Param/Value/lib_5A1C9904_84C2FEEA"), StringExternal("Param/Value/lib_5A1C9904_978D5B47"), "");
        gv_goliathTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 280, StringExternal("Param/Value/lib_5A1C9904_4317D246"), StringExternal("Param/Value/lib_5A1C9904_A8E43C3A"), "");
        gv_marineTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 340, StringExternal("Param/Value/lib_5A1C9904_C66F8CE5"), StringExternal("Param/Value/lib_5A1C9904_8C8B006A"), "");
