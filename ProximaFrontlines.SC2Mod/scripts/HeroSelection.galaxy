        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 220, StringExternal("Param/Value/lib_5A1C9904_215DA594"), StringExternal("Param/Value/lib_5A1C9904_B5ED5957"), "");
        gv_dragoonTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 280, StringExternal("Param/Value/lib_5A1C9904_CC9D57B8"), StringExternal("Param/Value/lib_5A1C9904_50B05475"), "");
        gv_darkTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 340, StringExternal("Param/Value/lib_5A1C9904_03C0B059"), StringExternal("Param/Value/lib_5A1C9904_8C87B31B"), "");
        gv_corsairTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 400, StringExternal("Param/Value/lib_5A1C9904_7E09F6B4"), StringExternal("Param/Value/lib_5A1C9904_C8FFA6CD"), "");
        gv_mothershipTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 20, c_anchorTop, lv_infoLabelXPos, 80, StringExternal("Param/Value/lib_5A1C9904_34AE88BC"), ColorWithAlpha(255,200,100,255), false, 1.0);
        gv_infoHeroNameTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 70, c_anchorTop, lv_infoLabelXPos, 125, StringExternal("Param/Value/lib_5A1C9904_ZealotAbility1"), ColorWithAlpha(255,255,255,255), false, 0.85);
        gv_infoAbility1Team2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 70, c_anchorTop, lv_infoLabelXPos, 200, StringExternal("Param/Value/lib_5A1C9904_ZealotAbility2"), ColorWithAlpha(255,255,255,255), false, 0.85);
        gv_infoAbility2Team2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 70, c_anchorTop, lv_infoLabelXPos, 275, StringExternal("Param/Value/lib_5A1C9904_ZealotAbility3"), ColorWithAlpha(255,255,255,255), false, 0.85);
        gv_infoAbility3Team2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 70, c_anchorTop, lv_infoLabelXPos, 350, StringExternal("Param/Value/lib_5A1C9904_ZealotAbility4"), ColorWithAlpha(255,255,255,255), false, 0.85);
        gv_infoAbility4Team2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 35, c_anchorTop, lv_infoLabelXPos, 433, StringExternal("Param/Value/lib_5A1C9904_ZealotDifficulty"), ColorWithAlpha(255,200,100,255), false, 0.85);
        gv_infoDifficultyTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam2, lv_infoLabelWidth, 70, c_anchorTop, lv_infoLabelXPos, 468, StringExternal("Param/Value/lib_5A1C9904_ZealotStrengths"), ColorWithAlpha(255,200,100,255), false, 0.85);
        gv_infoStrengthsTeam2 = DialogControlLastCreated();
    }

    lv_raceCheck = IsKnownRace(gv_rTSPlayer2);
    if ((lv_raceCheck == false)) {
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 100, StringExternal("Param/Value/lib_5A1C9904_47065936"), StringExternal("Param/Value/lib_5A1C9904_479173BD"), "");
        gv_zealotTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 160, StringExternal("Param/Value/lib_5A1C9904_F5516FBF"), StringExternal("Param/Value/lib_5A1C9904_EC5A43FE"), "");
        gv_sentryTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 220, StringExternal("Param/Value/lib_5A1C9904_0E44D467"), StringExternal("Param/Value/lib_5A1C9904_D44D7EFC"), "");
        gv_dragoonTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 280, StringExternal("Param/Value/lib_5A1C9904_3C7C04B9"), StringExternal("Param/Value/lib_5A1C9904_C32A4E04"), "");
        gv_darkTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 340, StringExternal("Param/Value/lib_5A1C9904_964EEB0B"), StringExternal("Param/Value/lib_5A1C9904_698DE8D6"), "");
        gv_corsairTemplarTeam2 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 400, StringExternal("Param/Value/lib_5A1C9904_12C4A045"), StringExternal("Param/Value/lib_5A1C9904_7C62B8C6"), "");
        gv_mothershipTeam2 = DialogControlLastCreated();
    }

    // Lock In button
    libNtve_gf_CreateDialogItemButton(gv_dialogTeam2, lv_lockInButtonWidth, lv_lockInButtonHeight, c_anchorTopLeft, lv_lockInButtonXPos, lv_lockInButtonYPos, StringExternal("Param/Value/lib_5A1C9904_LockInButton"), StringExternal("Param/Value/lib_5A1C9904_LockInTooltip"), "");
    gv_lockInButtonTeam2 = DialogControlLastCreated();
    libNtve_gf_SetDialogItemText(gv_lockInButtonTeam2, StringExternal("Param/Value/lib_5A1C9904_LockInButton"), PlayerGroupAll());

    DialogSetVisible(gv_dialogTeam2, gv_soldierPlayers2, true);
    DialogSetVisible(gv_dialogTeam2, gv_playersWhoPicked, false);

    // Set default hero based on RTS player race
    if ((PlayerRace(gv_rTSPlayer2) == "Zerg")) {
        for (lv_pIdx = 1; lv_pIdx <= 15; lv_pIdx += 1) { gv_selectedHeroTeam2[lv_pIdx] = "ZerglingHero"; }
        libNtve_gf_SetDialogItemText(gv_infoHeroNameTeam2, StringExternal("Param/Value/lib_5A1C9904_ZerglingName"), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(gv_heroPortraitTeam2, "Assets\\Textures\\ZerglingPortrait_Static.dds", gv_soldierPlayers2);
    }
    else if ((PlayerRace(gv_rTSPlayer2) == "Terr")) {
        for (lv_pIdx = 1; lv_pIdx <= 15; lv_pIdx += 1) { gv_selectedHeroTeam2[lv_pIdx] = "FirebatHero"; }
        libNtve_gf_SetDialogItemText(gv_infoHeroNameTeam2, StringExternal("Param/Value/lib_5A1C9904_FirebatName"), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(gv_heroPortraitTeam2, "Assets\\Textures\\marinemercenaryportrait_static.dds", gv_soldierPlayers2);
    }
    else if ((PlayerRace(gv_rTSPlayer2) == "Prot")) {
        for (lv_pIdx = 1; lv_pIdx <= 15; lv_pIdx += 1) { gv_selectedHeroTeam2[lv_pIdx] = "ZealotHero"; }
        libNtve_gf_SetDialogItemText(gv_infoHeroNameTeam2, StringExternal("Param/Value/lib_5A1C9904_ZealotName"), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(gv_heroPortraitTeam2, "Assets\\Textures\\AiurZealotPortrait_Static.dds", gv_soldierPlayers2);
    }

    DisableaDialogItem(gv_sentryTemplarTeam2);
    DisableaDialogItem(gv_corsairTemplarTeam2);
    DisableaDialogItem(gv_darkTemplarTeam2);
    DisableaDialogItem(gv_defilerTeam2);
    DisableaDialogItem(gv_dragoonTemplarTeam2);
    DisableaDialogItem(gv_firebatTeam2);
    DisableaDialogItem(gv_goliathTeam2);
    DisableaDialogItem(gv_hydraliskTeam2);
    DisableaDialogItem(gv_marineTeam2);
    DisableaDialogItem(gv_medicTeam2);
    DisableaDialogItem(gv_queenTeam2);
    DisableaDialogItem(gv_spectreTeam2);
    DisableaDialogItem(gv_ultraliskTeam2);
    DisableaDialogItem(gv_zealotTeam2);
    DisableaDialogItem(gv_zerglingTeam2);
    DisableaDialogItem(gv_nydusTeam2);
    DisableaDialogItem(gv_scienceVesselTeam2);
    DisableaDialogItem(gv_mothershipTeam2);
    DisableaDialogItem(gv_lockInButtonTeam2);
    Wait(2.0, c_timeReal);
    EnableaDialogItem(gv_sentryTemplarTeam2);
    EnableaDialogItem(gv_corsairTemplarTeam2);
    EnableaDialogItem(gv_darkTemplarTeam2);
    EnableaDialogItem(gv_defilerTeam2);
    EnableaDialogItem(gv_dragoonTemplarTeam2);
    EnableaDialogItem(gv_firebatTeam2);
    EnableaDialogItem(gv_goliathTeam2);
    EnableaDialogItem(gv_hydraliskTeam2);
    EnableaDialogItem(gv_marineTeam2);
    EnableaDialogItem(gv_medicTeam2);
    EnableaDialogItem(gv_queenTeam2);
    EnableaDialogItem(gv_spectreTeam2);
    EnableaDialogItem(gv_ultraliskTeam2);
    EnableaDialogItem(gv_zealotTeam2);
    EnableaDialogItem(gv_zerglingTeam2);
    EnableaDialogItem(gv_scienceVesselTeam2);
    EnableaDialogItem(gv_nydusTeam2);
    EnableaDialogItem(gv_mothershipTeam2);
    EnableaDialogItem(gv_lockInButtonTeam2);
    return true;
}
