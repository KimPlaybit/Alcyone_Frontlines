    DialogSetVisible(gv_dialogTeam1, gv_soldierPlayers1, true);
    DialogSetVisible(gv_dialogTeam1, gv_playersWhoPicked, false);

    // Set default hero based on RTS player race
    if ((PlayerRace(gv_rTSPlayer1) == "Zerg")) {
        for (lv_pIdx = 1; lv_pIdx <= 15; lv_pIdx += 1) { gv_selectedHeroTeam1[lv_pIdx] = "ZerglingHero"; }
        libNtve_gf_SetDialogItemText(gv_infoHeroNameTeam1, StringExternal("Param/Value/lib_5A1C9904_ZerglingName"), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(gv_heroPortraitTeam1, "Assets\\Textures\\ZerglingPortrait_Static.dds", gv_soldierPlayers1);
    }
    else if ((PlayerRace(gv_rTSPlayer1) == "Terr")) {
        for (lv_pIdx = 1; lv_pIdx <= 15; lv_pIdx += 1) { gv_selectedHeroTeam1[lv_pIdx] = "FirebatHero"; }
        libNtve_gf_SetDialogItemText(gv_infoHeroNameTeam1, StringExternal("Param/Value/lib_5A1C9904_FirebatName"), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(gv_heroPortraitTeam1, "Assets\\Textures\\FirebatPortrait_Static.dds", gv_soldierPlayers1);
    }
    else if ((PlayerRace(gv_rTSPlayer1) == "Prot")) {
        for (lv_pIdx = 1; lv_pIdx <= 15; lv_pIdx += 1) { gv_selectedHeroTeam1[lv_pIdx] = "ZealotHero"; }
        libNtve_gf_SetDialogItemText(gv_infoHeroNameTeam1, StringExternal("Param/Value/lib_5A1C9904_ZealotName"), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(gv_heroPortraitTeam1, "Assets\\Textures\\AiurZealotPortrait_Static.dds", gv_soldierPlayers1);
    }

    DisableaDialogItem(gv_sentryTemplarTeam1);
    DisableaDialogItem(gv_corsairTemplarTeam1);
    DisableaDialogItem(gv_darkTemplarTeam1);
    DisableaDialogItem(gv_defilerTeam1);
    DisableaDialogItem(gv_dragoonTemplarTeam1);
    DisableaDialogItem(gv_firebatTeam1);
    DisableaDialogItem(gv_goliathTeam1);
    DisableaDialogItem(gv_hydraliskTeam1);
    DisableaDialogItem(gv_marineTeam1);
    DisableaDialogItem(gv_medicTeam1);
    DisableaDialogItem(gv_queenTeam1);
    DisableaDialogItem(gv_spectreTeam1);
    DisableaDialogItem(gv_ultraliskTeam1);
    DisableaDialogItem(gv_zealotTeam1);
    DisableaDialogItem(gv_zerglingTeam1);
    DisableaDialogItem(gv_nydusTeam1);
    DisableaDialogItem(gv_scienceVesselTeam1);
    DisableaDialogItem(gv_mothershipTeam1);
    DisableaDialogItem(gv_lockInButtonTeam1);
    Wait(2.0, c_timeReal);
    EnableaDialogItem(gv_sentryTemplarTeam1);
    EnableaDialogItem(gv_corsairTemplarTeam1);
    EnableaDialogItem(gv_darkTemplarTeam1);
    EnableaDialogItem(gv_defilerTeam1);
    EnableaDialogItem(gv_dragoonTemplarTeam1);
    EnableaDialogItem(gv_firebatTeam1);
    EnableaDialogItem(gv_goliathTeam1);
    EnableaDialogItem(gv_hydraliskTeam1);
    EnableaDialogItem(gv_marineTeam1);
    EnableaDialogItem(gv_medicTeam1);
    EnableaDialogItem(gv_queenTeam1);
    EnableaDialogItem(gv_spectreTeam1);
    EnableaDialogItem(gv_ultraliskTeam1);
    EnableaDialogItem(gv_zealotTeam1);
    EnableaDialogItem(gv_zerglingTeam1);
    EnableaDialogItem(gv_scienceVesselTeam1);
    EnableaDialogItem(gv_nydusTeam1);
    EnableaDialogItem(gv_mothershipTeam1);
    EnableaDialogItem(gv_lockInButtonTeam1);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Soldier Selection Team 2
//--------------------------------------------------------------------------------------------------
trigger auto_SoldierSelectionTeam2_Trigger = null;

void SoldierSelectionTeam2 () {
    if (auto_SoldierSelectionTeam2_Trigger == null) {
        auto_SoldierSelectionTeam2_Trigger = TriggerCreate("auto_SoldierSelectionTeam2_TriggerFunc");
    }
    TriggerExecute(auto_SoldierSelectionTeam2_Trigger, false, false);
}

bool auto_SoldierSelectionTeam2_TriggerFunc (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_raceCheck;
    int lv_dialogWidth        = 1200;
    int lv_dialogHeight       = 600;
