//--------------------------------------------------------------------------------------------------
// Trigger: Lock In Button Team 2
//--------------------------------------------------------------------------------------------------
bool LockInButtonTeam2_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_heroDisplayName;
    
    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_lockInButtonTeam2 == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((StringLength(gv_selectedHeroTeam2[EventPlayer()]) > 0)) {
        lv_heroDisplayName = gv_selectedHeroTeam2[EventPlayer()];
        if ((gv_selectedHeroTeam2[EventPlayer()] == "FirebatHero")) { lv_heroDisplayName = "Firebat"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "MedicHero")) { lv_heroDisplayName = "Medic"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "MarineHero")) { lv_heroDisplayName = "Marine"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "GoliathHero")) { lv_heroDisplayName = "Goliath"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "SpectreHero")) { lv_heroDisplayName = "Spectre"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "ZealotHero")) { lv_heroDisplayName = "Zealot"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "AvengerHero")) { lv_heroDisplayName = "Dark Templar"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "DragoonHero")) { lv_heroDisplayName = "Dragoon"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "SentryPurifier2")) { lv_heroDisplayName = "Sentry"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "AdeptHero")) { lv_heroDisplayName = "Adept"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "CorsairHero")) { lv_heroDisplayName = "Corsair"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "MothershipCoreHero")) { lv_heroDisplayName = "Mothership Core"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "ZerglingHero")) { lv_heroDisplayName = "Zergling"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "BroodQueenHero")) { lv_heroDisplayName = "Brood Queen"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "DefilerHero")) { lv_heroDisplayName = "Defiler"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "HydraliskHero")) { lv_heroDisplayName = "Hydralisk"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "HotSTorrasque2")) { lv_heroDisplayName = "Ultralisk"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "MutaliskHero")) { lv_heroDisplayName = "Mutalisk"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "NydusCanal22")) { lv_heroDisplayName = "Nydus Worm"; }
        else if ((gv_selectedHeroTeam2[EventPlayer()] == "ScienceVessel2")) { lv_heroDisplayName = "Science Vessel"; }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (PlayerName(EventPlayer()) + StringToText(" picked " + lv_heroDisplayName)));

        libNtve_gf_UnitCreateFacingPoint(1, gv_selectedHeroTeam2[EventPlayer()], 0, EventPlayer(), gv_startPosition2, PlayerStartLocation(gv_rTSPlayer1));
        DialogSetVisible(gv_dialogTeam2, PlayerGroupSingle(EventPlayer()), false);
        UnitSelect(UnitLastCreated(), EventPlayer(), true);
        UnitGroupAdd(gv_revivableUnits, UnitLastCreated());
        UnitGroupAdd(gv_soldiers, UnitLastCreated());
        UnitControlGroupAddUnit(EventPlayer(), 1, UnitLastCreated());
        PlayerGroupAdd(gv_playersWhoPicked, EventPlayer());
        gv_playerPicked[EventPlayer()] = true;
    }
    return true;
}

