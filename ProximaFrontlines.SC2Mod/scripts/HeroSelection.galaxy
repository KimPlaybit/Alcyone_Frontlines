        else if ((gv_selectedHeroTeam1[EventPlayer()] == "DefilerHero")) { lv_heroDisplayName = "Defiler"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "HydraliskHero")) { lv_heroDisplayName = "Hydralisk"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "HotSTorrasque2")) { lv_heroDisplayName = "Ultralisk"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "MutaliskHero")) { lv_heroDisplayName = "Mutalisk"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "NydusCanal22")) { lv_heroDisplayName = "Nydus Worm"; }
        else if ((gv_selectedHeroTeam1[EventPlayer()] == "ScienceVessel2")) { lv_heroDisplayName = "Science Vessel"; }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (PlayerName(EventPlayer()) + StringToText(" picked " + lv_heroDisplayName)));
        libNtve_gf_UnitCreateFacingPoint(1, gv_selectedHeroTeam1[EventPlayer()], 0, EventPlayer(), gv_startPosition1, PlayerStartLocation(gv_rTSPlayer2));
        DialogSetVisible(gv_dialogTeam1, PlayerGroupSingle(EventPlayer()), false);
        UnitSelect(UnitLastCreated(), EventPlayer(), true);
        UnitGroupAdd(gv_revivableUnits, UnitLastCreated());
        UnitGroupAdd(gv_soldiers, UnitLastCreated());
        UnitControlGroupAddUnit(EventPlayer(), 1, UnitLastCreated());
        PlayerGroupAdd(gv_playersWhoPicked, EventPlayer());
        gv_playerPicked[EventPlayer()] = true;
    }
    return true;
}

