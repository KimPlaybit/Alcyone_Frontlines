        gv_infoStrengthsTeam1 = DialogControlLastCreated();
    }

    lv_raceCheck = IsZerg(gv_rTSPlayer1);
    if ((lv_raceCheck == true)) {
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 100, StringExternal("Param/Value/lib_5A1C9904_18851F8A"), StringExternal("Param/Value/lib_5A1C9904_E8978F42"), "");
