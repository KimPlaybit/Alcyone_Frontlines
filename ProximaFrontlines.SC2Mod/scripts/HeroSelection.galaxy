        gv_sentryTemplarTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 220, StringExternal("Param/Value/lib_5A1C9904_CC7022DA"), StringExternal("Param/Value/lib_5A1C9904_CAF32F13"), "");
        gv_dragoonTemplarTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemButton(gv_dialogTeam1, lv_buttonSizePickX, lv_buttonSizePickY, c_anchorTop, lv_buttonXPos, 280, StringExternal("Param/Value/lib_5A1C9904_C3A7A6BE"), StringExternal("Param/Value/lib_5A1C9904_6BCF858B"), "");
