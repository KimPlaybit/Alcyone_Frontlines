        gv_mothershipTeam1 = DialogControlLastCreated();
        libNtve_gf_CreateDialogItemLabel(gv_dialogTeam1, lv_infoLabelWidth, 20, c_anchorTop, lv_infoLabelXPos, 80, StringExternal("Param/Value/lib_5A1C9904_6F27D176"), ColorWithAlpha(255,200,100,255), false, 1.0);
