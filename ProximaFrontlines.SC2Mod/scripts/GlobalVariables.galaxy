//==================================================================================================
// Proxima Frontlines � Global Variables
// Struct definitions, global declarations, trigger variables, function forward declarations,
// and variable initialization. Follows SSF-style: all declarations at top, InitVariables() last.
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// Structs
//--------------------------------------------------------------------------------------------------

struct gs_SpawnerInfo {
    string lv_unitType;
    point  lv_point;
    int    lv_player;
};

struct gs_CreatedSpawner {
    unit      lv_spawner;
    int       lv_lastIndexPoint;
    point[11] lv_movePoints;
    int       lv_amountOfUnits;
    string    lv_waveUnitType;
};

struct gs_JunglePrice {
    string lv_unitType;
    int    lv_minerals;
    int    lv_gas;
};

//--------------------------------------------------------------------------------------------------
// Function Forward Declarations
//--------------------------------------------------------------------------------------------------
// Bank
void LoadFromLobby (point lp_startPosition1, point lp_startPosition2);
bool LoadedFromBank (point lp_startPosition1, point lp_startPosition2);
playergroup LoadPlayersFromBank (bank lp_bank, string lp_key);
int LoadRTSPlayer (bank lp_bank, string lp_key);
void SetRTSPlayerRace (bank lp_bank, string lp_key, int lp_player);

// Player
bool IsKnownRace (int lp_player);
bool IsProtoss (int lp_rTSPlayer);
bool IsZerg (int lp_rTSPlayer);
bool IsTerran (int lp_rTSPlayer);
bool WithRTSPlayer ();
bool IsSurvival ();
string GetPlayerRaceName (int lp_player);
int GetAllyRTSPlayer (int lp_player);
int GetWavesPlayer (int lp_player);
int GetEnemyRTSPlayer (int lp_player);
bool AddUpdateForWaves (string lp_upgrade, int lp_killingPlayer);
bool RemoveUpdateForWaves (string lp_upgrade, int lp_killingPlayer);
void GiveXPForHeroKills (unit lp_killingSoldier, unit lp_killedSoldier);
void SetSize (unit lp_unitToSizeUp);
point GetSpawnPointTeam1 (unit lp_deadPlayer);
point GetSpawnPointTeam2 (unit lp_deadPlayer);
void UpdateScoreboard (int lp_kills, int lp_deaths, int lp_minerals, int lp_gas, int lp_triggeringPlayer);
void DisplayDeathMessage (unit lp_killed, unit lp_killer, fixed lp_reviveTime);
void Corsair (int lp_player, unit lp_unit);

// MapInit
void StartProximaGame (point lp_startPosition1, point lp_startPosition2, fixed lp_turretOffset1X, fixed lp_turretOffset1Y, fixed lp_turretOffset2X, fixed lp_turretOffset2Y);
bool GetWaveStatus ();
bool GetTurretStatus ();
void SpawnDefenceTower (int lp_rTSPlayer, int lp_spawnForPlayer, point lp_spawn, point lp_facing);
point GetStartLocation (int lp_player);
void ProximaGameOver (int lp_losingRTSPlayer, playergroup lp_losingTeam, int lp_winningRTSPlayer, playergroup lp_winningTeam);
void SetupTeams1 ();
void SetupTeams2 ();

// Spawner
void ResetCooldownOfShadowFury (unit lp_killingUnit);
void AddNewWavePoint (point lp_point, int lp_spawnerIndex);
void CreateSpawners ();
int AddSpawner (point lp_point, string lp_unitType, string lp_waveUnitType, int lp_waveUnitAmount, int lp_player);
string GetDefaultSpawnerType (int lp_alliedPlayer);
string GetDefaultWaveType (int lp_alliedPlayer);
int GetDefaultWaveAmount (int lp_alliedPlayer);

// Jungle
void CreateJungleUnits (int lp_index, structref<lib5A1C9904_gs_Spawn> lp_unitsToSpawn);
void SpawnJungleUnits ();
void AddJungleSpawn (structref<lib5A1C9904_gs_Spawn> lp_toSpawn);
void AddJungleUnitGroup (unitgroup lp_addUnitGroup, point lp_minimapPoint);
void AddUnitJunglePrice (string lp_unitType, int lp_minerals, int lp_gas);
void GiveResource (unit lp_killedUnit, int lp_player, int lp_killingPlayer);
void Respawn (unit lp_killedUnit, unit lp_killingUnit);

// UI
void DisableaDialogItem (int lp_dialogItem);
void EnableaDialogItem (int lp_dialogItem);
void Scores ();

// AI
unit FindHealspot (unit lp_unit);
unit FindEnemyHero (unit lp_unit);
unitgroup GetSpawners (int lp_player);
unit SpawnersBeingAttacked (unit lp_heroUnit, int lp_player);
point ClosestPoint (point lp_lastPoint, point lp_unitPoint, unitgroup lp_pointToAttack, point lp_startPoint);
point AttackPointHostiles (point lp_startPos, point lp_currentPosition, int lp_veteranLevel, int lp_offsetVeterancy);
void StartAi (point lp_startPos, int lp_player);
void StartSoldierAI (point lp_startPos, int lp_player, unit lp_wave);
void HeroSpells (int lp_player, unit lp_unit);

// HeroSelection
void UpdateHeroInfoTeam1 (string lp_heroType);
void UpdateHeroInfoTeam2 (string lp_heroType);

// SoldierSelection (pre-existing files)
