    gv_zergling_2 = UnitGroupEmpty();
    gv_marines_1 = UnitGroupEmpty();
    gv_marines_2 = UnitGroupEmpty();
    gv_boss = UnitGroupEmpty();
    for (init_i = 1; init_i <= 15; init_i += 1) {
        gv_selectedHeroTeam1[init_i] = "";
        gv_selectedHeroTeam2[init_i] = "";
    }
    gv_level2Dialog = c_invalidDialogId;
    gv_level2WorkerProtectionButton = c_invalidDialogControlId;
    gv_level2HeroicVulnerabilityButton = c_invalidDialogControlId;
    gv_level2BootsButton = c_invalidDialogControlId;
    gv_level2SelectedUnit = null;
    gv_level5Dialog = c_invalidDialogId;
    gv_level5EnergyRegenButton = c_invalidDialogControlId;
    gv_level5HealingBoostButton = c_invalidDialogControlId;
    gv_level5DamageBoostButton = c_invalidDialogControlId;
    gv_level5SelectedUnit = null;
    gv_level7Dialog = c_invalidDialogId;
    gv_level7GlassCannonButton = c_invalidDialogControlId;
    gv_level7StructureDefenseButton = c_invalidDialogControlId;
    gv_level7AlliedEnergyAuraButton = c_invalidDialogControlId;
    gv_level7SelectedUnit = null;
