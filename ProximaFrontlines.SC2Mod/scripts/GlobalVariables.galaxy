//--------------------------------------------------------------------------------------------------
// Variable Initialization
//--------------------------------------------------------------------------------------------------
bool InitVariables_completed = false;

void ProximaInitVariables () {
    int init_i;

    if (InitVariables_completed) {
        return;
    }

    InitVariables_completed = true;

    gv_terranFactions = "terran,genetron,forces of augustgrad,jakob revenge,last terran,New Confederacy,outcasts,paramilitary,Second Military Expeditionary Force,specialoperatives,Blue Intel,corps,Antamo,smef";
    gv_zergFactions = "zerg,xayid,devil mai,Followers Of Nekta'la,last zerg,Nekta'la's Swarm,xill,Packs of Zerus,Cyber Zerg,Combined Broods,Corrupted race,Taken";
    gv_protossFactions = "protoss,dark ones,foundation,high ones,holo,last toss,legion of mal'tanis,pure born,the chosen,Eternals,Special operatives,The Chosen,Castaway";
    gv_rtsPlayer2Buildings = UnitGroupEmpty();
    gv_rtsPlayer2TownBuilding = UnitGroupEmpty();
    gv_rtsPlayer1Buildings = UnitGroupEmpty();
    gv_rtsPlayer1TownBuilding = UnitGroupEmpty();
    gv_soldiers = UnitGroupEmpty();
    gv_soldierPlayers1 = PlayerGroupEmpty();
    gv_soldierPlayers2 = PlayerGroupEmpty();
    gv_rTSPlayer1 = PlayerGroupPlayer(GameAttributePlayersForTeam(1), 1);
    gv_rTSPlayer2 = PlayerGroupPlayer(GameAttributePlayersForTeam(2), 1);
    for (init_i = 0; init_i <= 99; init_i += 1) {
        gv_jungleUnitGroups[init_i] = UnitGroupEmpty();
    }
    gv_revivableUnits = UnitGroupEmpty();
    gv_ressTimer = 10;
    gv_healUnitsRTS1 = UnitGroupEmpty();
    gv_healUnitsRTS2 = UnitGroupEmpty();
    gv_unitGroup = UnitGroupEmpty();
    for (init_i = 0; init_i <= 16; init_i += 1) {
        gv_playerStats[init_i] = c_invalidDialogControlId;
    }
    for (init_i = 0; init_i <= 16; init_i += 1) {
        gv_playerMiGa[init_i] = c_invalidDialogControlId;
    }
    gv_scoreDialog = c_invalidDialogId;
    gv_hiddenDialog = c_invalidDialogId;
    gv_showScore = c_invalidDialogControlId;
    gv_hideScore = c_invalidDialogControlId;
    gv_dialogTeam1 = c_invalidDialogId;
    gv_infoPanelTeam1 = c_invalidDialogControlId;
    gv_firebatTeam1 = c_invalidDialogControlId;
    gv_medicTeam1 = c_invalidDialogControlId;
    gv_goliathTeam1 = c_invalidDialogControlId;
    gv_marineTeam1 = c_invalidDialogControlId;
    gv_spectreTeam1 = c_invalidDialogControlId;
    gv_zealotTeam1 = c_invalidDialogControlId;
    gv_darkTemplarTeam1 = c_invalidDialogControlId;
    gv_dragoonTemplarTeam1 = c_invalidDialogControlId;
    gv_sentryTemplarTeam1 = c_invalidDialogControlId;
    gv_corsairTemplarTeam1 = c_invalidDialogControlId;
    gv_zerglingTeam1 = c_invalidDialogControlId;
    gv_queenTeam1 = c_invalidDialogControlId;
    gv_defilerTeam1 = c_invalidDialogControlId;
    gv_hydraliskTeam1 = c_invalidDialogControlId;
    gv_ultraliskTeam1 = c_invalidDialogControlId;
    gv_scienceVesselTeam1 = c_invalidDialogControlId;
    gv_nydusTeam1 = c_invalidDialogControlId;
    gv_mothershipTeam1 = c_invalidDialogControlId;
    gv_dialogTeam2 = c_invalidDialogId;
    gv_infoPanelTeam2 = c_invalidDialogControlId;
    gv_firebatTeam2 = c_invalidDialogControlId;
    gv_medicTeam2 = c_invalidDialogControlId;
    gv_goliathTeam2 = c_invalidDialogControlId;
    gv_marineTeam2 = c_invalidDialogControlId;
    gv_spectreTeam2 = c_invalidDialogControlId;
    gv_zealotTeam2 = c_invalidDialogControlId;
    gv_darkTemplarTeam2 = c_invalidDialogControlId;
    gv_dragoonTemplarTeam2 = c_invalidDialogControlId;
