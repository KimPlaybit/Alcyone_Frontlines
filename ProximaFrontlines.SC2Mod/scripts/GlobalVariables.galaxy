    gv_corsairTemplarTeam2 = c_invalidDialogControlId;
    gv_zerglingTeam2 = c_invalidDialogControlId;
    gv_queenTeam2 = c_invalidDialogControlId;
    gv_defilerTeam2 = c_invalidDialogControlId;
    gv_hydraliskTeam2 = c_invalidDialogControlId;
    gv_ultraliskTeam2 = c_invalidDialogControlId;
    gv_scienceVesselTeam2 = c_invalidDialogControlId;
    gv_nydusTeam2 = c_invalidDialogControlId;
    gv_mothershipTeam2 = c_invalidDialogControlId;
    gv_playersWhoPicked = PlayerGroupEmpty();
    gv_zerglingExpansionTeam2 = UnitGroupEmpty();
    gv_zerglingExpansionTeam1 = UnitGroupEmpty();
    gv_zergExpansionTeam1 = UnitGroupEmpty();
    gv_zergExpansionTeam2 = UnitGroupEmpty();
    gv_terranExpansionTeam1 = UnitGroupEmpty();
    gv_terranExpansionTeam2 = UnitGroupEmpty();
    gv_topExpansionTeam1 = UnitGroupEmpty();
