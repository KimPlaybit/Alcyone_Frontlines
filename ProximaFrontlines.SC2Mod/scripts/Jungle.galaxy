void CreateJungleUnits (int lp_index, structref<lib5A1C9904_gs_Spawn> lp_unitsToSpawn) {
    // Variable Declarations
    int lv_spawnLoop;
    unitgroup lv_units;

    // Automatic Variable Declarations
    playergroup auto9CADB851_g;
    const int autoD5456E40_ae = 4;
    const int autoD5456E40_ai = 1;

    // Variable Initialization
    lv_units = UnitGroupEmpty();

    // Implementation
    libNtve_gf_CreateUnitsAtPoint2(1, "SpawnPoints", 0, 0, lp_unitsToSpawn.lv_point);
    gv_spawnPoints[lp_index] = UnitLastCreated();
    auto9CADB851_g = PlayerGroupAll();
    lv_spawnLoop = -1;
    while (true) {
        lv_spawnLoop = PlayerGroupNextPlayer(auto9CADB851_g, lv_spawnLoop);
        if (lv_spawnLoop < 0) { break; }
        VisRevealArea(lv_spawnLoop, RegionCircle(lp_unitsToSpawn.lv_point, 1.0), 0.1, false);
    }
    lv_spawnLoop = 0;
    for ( ; ( (autoD5456E40_ai >= 0 && lv_spawnLoop <= autoD5456E40_ae) || (autoD5456E40_ai < 0 && lv_spawnLoop >= autoD5456E40_ae) ) ; lv_spawnLoop += autoD5456E40_ai ) {
        if ((lp_unitsToSpawn.lv_unitSpawn[lv_spawnLoop].lv_unitType != "")) {
            libNtve_gf_CreateUnitsAtPoint2(lp_unitsToSpawn.lv_unitSpawn[lv_spawnLoop].lv_amount, lp_unitsToSpawn.lv_unitSpawn[lv_spawnLoop].lv_unitType, 0, 15, gv_jungleToSpawn[lp_index].lv_point);
            UnitGroupAddUnitGroup(lv_units, UnitLastCreatedGroup());
        }

    }
    gv_jungleUnitGroups[lp_index] = lv_units;
}

void SpawnJungleUnits () {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    int auto7931081A_ae;
    const int auto7931081A_ai = 1;

    // Implementation
    auto7931081A_ae = (gv_lastIndexOfSpawn - 1);
    lv_index = 0;
    for ( ; ( (auto7931081A_ai >= 0 && lv_index <= auto7931081A_ae) || (auto7931081A_ai < 0 && lv_index >= auto7931081A_ae) ) ; lv_index += auto7931081A_ai ) {
        gv_indexToSpawn = lv_index;
        TriggerExecute(SpawnJungle, true, false);
    }
}

void AddJungleSpawn (structref<lib5A1C9904_gs_Spawn> lp_toSpawn) {
    // Variable Declarations
    int lv_spawnLoop;

    // Automatic Variable Declarations
    const int auto93DBA21B_ae = 4;
    const int auto93DBA21B_ai = 1;

