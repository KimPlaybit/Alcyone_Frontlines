//--------------------------------------------------------------------------------------------------
// Trigger: AI Team 1
//--------------------------------------------------------------------------------------------------
bool AITeam1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_lastCreatedUnit;
    point lv_startPos;
    int lv_random;
    int lv_player;
    int lv_playerToSpawnFor;
    bool lv_raceCheck;

    // Automatic Variable Declarations
    playergroup auto77236139_g;
    int auto74D8FDF6_val;
    int autoE03F8687_val;
    int autoC41BA067_val;
    int autoD1FD18C2_val;

    // Variable Initialization
    lv_startPos = gv_startPosition1;

    // Actions
    if (!runActions) {
        return true;
    }

    auto77236139_g = gv_soldierPlayers1;
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto77236139_g, lv_player);
        if (lv_player < 0) { break; }
        if (((PlayerType(lv_player) == c_playerTypeComputer) == true)) {
            if ((PlayerType(gv_rTSPlayer1) == c_playerTypeComputer)) {
                lv_playerToSpawnFor = lv_player;
            }
            else {
                lv_playerToSpawnFor = lv_player;
            }
            lv_random = RandomInt(0, 3);
            lv_raceCheck = IsTerran(gv_rTSPlayer1);
            if ((lv_raceCheck == true)) {
                auto74D8FDF6_val = lv_random;
                if (auto74D8FDF6_val == 0) {
                    libNtve_gf_UnitCreateFacingPoint(1, "FirebatHero", 0, lv_playerToSpawnFor, lv_startPos, PlayerStartLocation(gv_rTSPlayer2));
                    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (PlayerName(lv_player) + StringExternal("Param/Value/lib_5A1C9904_D9CB5152")));
                }
